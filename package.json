{
  "name": "misendero",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prepare:ai-datasets": "node scripts/train-ai.js --prepare",
    "validate:privacy": "py training/python/validate_datasets.py",
    "typecheck": "tsc --noEmit",
    "train:ai": "node scripts/train-ai.js",
    "train:route-difficulty": "node scripts/train-ai.js --model route_difficulty",
    "train:apn-difficulty": "node scripts/train-ai.js --model apn_route_difficulty",
    "test": "jest",
    "test:functional": "node testing/functional/run.cjs",
    "test:coverage": "node --test testing/coverage-tools.test.cjs && node testing/run-coverage.cjs",
    "test:coverage:python": "node testing/run-python-coverage.cjs",
    "validate:ai-data": "node scripts/train-ai.js --validate",
    "test:ai-data": "node scripts/train-ai.js --test",
    "fetch:ai-data": "node scripts/train-ai.js --fetch"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-modules-core": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sms": "~57.0.2",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-three": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "three": "^0.166.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/three": "^0.166.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
