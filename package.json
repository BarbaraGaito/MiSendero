{
  "name": "misendero",
  "version": "1.0.3",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prepare:offline-maps": "node scripts/prepare-offline-maps.cjs",
    "validate:offline-maps": "node --test testing/offline-maps.test.cjs",
    "prepare:ai-datasets": "node scripts/train-ai.js --prepare",
    "validate:privacy": "py training/python/validate_datasets.py",
    "typecheck": "tsc --noEmit",
    "train:ai": "node scripts/train-ai.js",
    "ai:field": "node scripts/field-ai.cjs",
    "train:route-difficulty": "node scripts/train-ai.js --model route_difficulty",
    "train:apn-difficulty": "node scripts/train-ai.js --model apn_route_difficulty",
    "test": "jest",
    "test:functional": "node testing/functional/run.cjs",
    "test:coverage": "node --test testing/coverage-tools.test.cjs && node testing/run-coverage.cjs",
    "test:coverage:python": "node testing/run-python-coverage.cjs",
    "validate:ai-data": "node scripts/train-ai.js --validate",
    "evaluate:ai": "node scripts/train-ai.js --refresh-evaluation",
    "test:ai-data": "node scripts/train-ai.js --test",
    "fetch:ai-data": "node scripts/train-ai.js --fetch",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "validate:apk": "node scripts/validate-apk.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-battery": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-gl": "~58.0.4",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.5",
    "expo-sms": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "fast-png": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "0.166.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "0.166.0",
    "eas-cli": "25.2.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
