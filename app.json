{
  "expo": {
    "name": "MiSendero",
    "slug": "misendero",
    "owner": "lara_alonso",
    "version": "1.0.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "misendero",
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MiSendero usa tu ubicación durante el recorrido para mostrar tu posición y registrar la actividad.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8"
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "MiSendero permite leer, con tu autorización opcional, frecuencia cardiaca, actividad y oxígeno de Salud para mostrar métricas locales de tu recorrido. No realiza diagnóstico ni tiene modelos aprobados para uso en campo.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "MiSendero lee el acelerómetro durante un recorrido, solo si activás la detección de caídas experimental. El procesamiento es local y los datos del sensor no se envían."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.misendero.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "allowBackup": false,
      "package": "com.misendero.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1E8"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SPEED",
        "android.permission.health.READ_OXYGEN_SATURATION"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3241b7f2-c7d3-490d-bf59-7da957bda44f"
      }
    }
  }
}
