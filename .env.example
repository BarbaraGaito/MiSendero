# Docker Compose local defaults. Copy this file to `.env` before running compose.
# Fill these with generated values before starting the stack.
JWT_SECRET=
POSTGRES_PASSWORD=
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3001
REPORT_STALE_AFTER_DAYS=30
LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Used only by docker-compose.images.yml. The GitHub workflow publishes this image.
MISENDERO_BACKEND_IMAGE=ghcr.io/barbaragaito/misendero-backend:latest

# Complete URL, including /api. Use HTTPS outside local development.
EXPO_PUBLIC_API_URL=
# HTTPS XYZ base-map source that permits offline downloads, or your own AWS tiles.
# Do not use tile.openstreetmap.org. No terrain or 3D provider is needed.
EXPO_PUBLIC_OFFLINE_STANDARD_TILE_URL=
# Optional online terrain layer; not downloaded for offline use.
EXPO_PUBLIC_OFFLINE_TERRAIN_TILE_URL=
EXPO_PUBLIC_OFFLINE_TILE_ATTRIBUTION=
# Record the base-map source terms and attribution before enabling downloads.
EXPO_PUBLIC_OFFLINE_TILE_LICENSE_URL=
EXPO_PUBLIC_OFFLINE_TILE_LICENSE_CONFIRMED=false

# Public channel owned and monitored by the actual data controller.
PRIVACY_CONTACT_URL=

# Backend only; optional local ranker. Empty directory uses the deterministic baseline.
TRAIL_ML_MODEL_DIR=
TRAIL_ML_PYTHON=python3
TRAIL_ML_TIMEOUT_MS=1500
