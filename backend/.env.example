PORT=3001
NODE_ENV=development

# PostgreSQL connection. With the root docker-compose.yml running (`docker compose up -d db`),
# this matches the default db/user/password defined there.
DATABASE_URL=postgres://misendero:misendero@localhost:5432/misendero

# Required at boot - the server refuses to start without it. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_generated_secret

# Comma-separated list of allowed origins for the mobile app / dev tools.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Trail reports older than this are hidden from GET /:id/reports and deleted by the
# periodic cleanup job (PDF section 2.1.7.1).
REPORT_STALE_AFTER_DAYS=30

# pino log level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# Local development auth throttling.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Optional adapter for overdue trip alerts. Its receiver must durably deduplicate
# Idempotency-Key, forward the message, and own delivery retries/escalation.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
