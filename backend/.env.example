PORT=3001
NODE_ENV=development

# PostgreSQL connection. With the root docker-compose.yml running (`docker compose up -d db`),
# this matches the default db/user/password defined there.
DATABASE_URL=postgres://misendero:misendero@localhost:5432/misendero

# Required at boot - the server refuses to start without it. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_generated_secret

# Production additionally requires a mounted CA bundle and a real privacy channel.
# Set a container-readable path, not a DSN sslmode=require shortcut.
PGSSLROOTCERT=
PRIVACY_CONTACT_URL=
# Optional learned ranking: SHA-256 of the approved model, pinned by the operator
# independently of the artifact metadata. Without it production uses baseline.
TRAIL_ML_TRUSTED_SHA256=

# Comma-separated list of allowed origins for the mobile app / dev tools.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Trail reports older than this are hidden from GET /:id/reports and deleted by the
# periodic cleanup job (PDF section 2.1.7.1).
REPORT_STALE_AFTER_DAYS=30

# pino log level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# Local development auth throttling.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Optional adapter for overdue trip alerts. Its receiver must durably deduplicate
# Idempotency-Key, forward the message, and own delivery retries/escalation.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Copernicus GLO-90 elevation. Public endpoint works without a key for this PFI.
# A commercial Open-Meteo subscription uses the customer endpoint and its API key.
ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation
ELEVATION_API_KEY=

# Public channel owned and monitored by the actual data controller (HTTPS/mailto).
# Supports requests about contact data and data not covered by account self service.
PRIVACY_CONTACT_URL=

# Optional local supervised ranker. Empty model directory means deterministic baseline.
# Use absolute paths on EC2. No external AI API key is needed.
TRAIL_ML_MODEL_DIR=
TRAIL_ML_PYTHON=python3
# Private inference deadline in milliseconds, clamped to 100..5000.
TRAIL_ML_TIMEOUT_MS=1500
