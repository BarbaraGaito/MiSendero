# Docker Compose local defaults. Copy this file to `.env` before running compose.
# Fill these with generated values before starting the stack.
JWT_SECRET=
POSTGRES_PASSWORD=
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3001
REPORT_STALE_AFTER_DAYS=30
LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Used only by docker-compose.images.yml. The GitHub workflow publishes this image.
MISENDERO_BACKEND_IMAGE=ghcr.io/barbaragaito/misendero-backend:latest
