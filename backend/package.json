{
  "name": "misendero-backend",
  "version": "1.0.0",
  "description": "Backend API for MiSendero",
  "main": "src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.ai.json",
    "dev": "npm run build && node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/migrate.js",
    "db:seed": "node src/seed.js",
    "db:elevation": "node src/backfillElevation.js",
    "db:catalog:preview": "node scripts/importCatalogExpansion.js --dry-run --local-only",
    "db:catalog:apply": "node scripts/importCatalogExpansion.js --apply --local-only",
    "db:catalog:media:preview": "node scripts/updateCatalogExpansionMedia.js --dry-run --local-only",
    "db:catalog:media:apply": "node scripts/updateCatalogExpansionMedia.js --apply --local-only",
    "catalog:export": "node scripts/exportCatalogFeatures.js",
    "catalog:validate": "npm run build && node scripts/validateCatalogRecommendations.js",
    "catalog:elevation:refresh": "node scripts/refreshRecommendationElevation.js",
    "ranking:prepare": "npm run build && node scripts/prepareTrailRanking.js",
    "ranking:smoke": "npm run build && node scripts/smokeTrailRanking.js",
    "ranking:coverage": "npm run build && node scripts/auditRecommendationCoverage.js",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jest": "^30.4.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
